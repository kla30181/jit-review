rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false; }
    match /datasets/{datasetId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /drafts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.ownerUid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /submissions/{submissionId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == submissionId;
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
